  "e01_seed_implementation": {
    "preimage": "UTF-8(pair_id + decimal_string(global_seed))  # NO separator",
    "digest": "SHA256(preimage).digest()",
    "operator_seed": "int.from_bytes(digest,'big') % 2**31",
