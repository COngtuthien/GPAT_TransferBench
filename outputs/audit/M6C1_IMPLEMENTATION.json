    "block_grid_mirror": "FORBIDDEN and demonstrably wrong: the pixel-wise image of block (0,0) spans rows {0} U [241,255] and is NOT a contiguous block (asserted in tests)",
    "application": "boolean selected-pixel mask -> conjugate mask -> union = edit mask; magnitude substituted on the union, target phase preserved",
    "max_abs_imag_white_noise": 1.0999371638972949e-13,
    "max_abs_imag_smooth_image": 3.2291627502247798e-12,
    "documented_tolerance": 1e-08,
