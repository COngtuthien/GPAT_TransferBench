 "owner_decisions": [
  {
   "activation": "configs/amendments/m10_resnet18_science_precision.yaml {status OWNER_APPROVED, approved true, policy}",
   "blocking": true,
   "id": "O1_science_precision",
   "options": {
    "A_CUDA_AMP_FP16_GRADSCALER_DETERMINISTIC": "torch.autocast(cuda, float16) + torch.amp.GradScaler('cuda') defaults (init 65536, growth 2, backoff 0.5, interval 2000); scaler.unscale_ before clip_grad_norm_; deterministic algorithms, cudnn deterministic, benchmark off, TF32 off, CUBLAS_WORKSPACE_CONFIG=:4096:8",
    "B_CUDA_AMP_BF16_DETERMINISTIC": "torch.autocast(cuda, bfloat16), no GradScaler; same determinism settings",
    "C_CUDA_FP32": "not eligible: spec 14 / downstream_resnet18.yaml fix amp: true"
   },
   "question": "D13 leaves the science AMP dtype and GradScaler policy (and the CUDA determinism settings) to be pinned before M10. Which precision policy do all 24 runs use?",
   "recommended": "A_CUDA_AMP_FP16_GRADSCALER_DETERMINISTIC",
   "why": "the standard CUDA AMP of the spec era; qualified bitwise replay on the RTX 3090 (synthetic fixtures); fastest measured step; skipped steps (inf gradients) are logged per step"
  },
  {
   "activation": "owner pin record + implementation change in science_runner (re-qualification required)",
   "blocking": true,
   "id": "O2_threshold_tie_rule",
   "options": {
    "A_SMALLER_THRESHOLD": "take the smaller of the tied thresholds; the epoch stays eligible",
    "B_LARGER_THRESHOLD": "take the larger of the tied thresholds",
    "C_EPOCH_INELIGIBLE": "record the epoch with no threshold and exclude it from checkpoint selection; the run fails only if every epoch is ineligible",
    "D_FAIL_CLOSED": "keep the current behaviour (any such epoch aborts the run for owner review)"
   },
   "question": "Spec 15 breaks ACER ties only by 'closest to 0.5'. When two minimum-ACER thresholds are equally close to 0.5 (always the case for constant or fully inverted VAL scores: 0 and 1 at ACER 1/2) the frozen rule selects nothing and the implementation aborts the whole run. Which completion applies?",
   "recommended": "C_EPOCH_INELIGIBLE",
   "why": "a tie this exact arises from degenerate or symmetric score sets; excluding such an epoch never lets an arbitrary direction choice decide the frozen threshold, and D5 still selects among well-defined epochs. Reproduced deterministically (qualification Q6, tests/test_m10_downstream_readiness)"
  },
  {
   "blocking": true,
   "id": "O3_checkpoint_retention_and_run_root",
   "options": {
    "A_SELECTED_ONLY_HDD_NEW_ROOT": "keep only the selected checkpoint (~45 MB/run, ~1.1 GB for 24); run roots under a new owner-approved HDD directory outside the bank root, e.g. /media/ext_data/student20261_gpat_m10_detectors/<group>/seed_<s>/",
    "B_SELECTED_ONLY_RUNTIME_ROOT": "selected checkpoint only, run roots under <runtime_root>/runs/m10/ on the system SSD (~1.3 GB total; reduces SSD headroom)",
    "C_ALL_EPOCHS_HDD_NEW_ROOT": "keep all 40 epoch checkpoints (~1.8 GB/run, ~43 GB) on a new HDD root"
   },
   "question": "Which checkpoints are kept, and where do detector run roots live? The system SSD holding the runtime root is ~97% full (~27 GB free); the approved HDD has ~3.0 TB free but only the bank root is registered.",
   "recommended": "A_SELECTED_ONLY_HDD_NEW_ROOT",
   "why": "D5 needs every epoch evaluated but only the selected checkpoint frozen; the SSD has little headroom; the HDD root must stay separate from the immutable bank root (its contents check refuses foreign entries)"
  },
  {
   "blocking": true,
   "id": "O4_science_environment",
   "options": {
    "A_APPROVE_UNCHANGED": "torch 2.12.1+cu130, torchvision 0.27.1, CUDA 13.0, driver 580.178.04 as locked",
    "B_NEW_ENVIRONMENT": "a separately locked environment (needs qualification)"
   },
   "question": "The evaluator contract authorized gpat-m8-downstream (environments/m8_downstream.lock.json) for the smoke only. Approve it (unchanged) for the M10 scientific runs?",
   "recommended": "A_APPROVE_UNCHANGED",
