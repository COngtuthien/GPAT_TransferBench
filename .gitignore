# GPAT-TransferBench .gitignore
# Policy: never ignore configs, manifests (incl. *.parquet), audit files, run metadata,
# hashes, provenance records or source traceability. Only caches, local environments,
# large raw/derived data and large binary weights are ignored; their provenance
# (paths + SHA256) must be recorded in tracked manifests/registries instead.

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments
.venv/
.venv-audit/
venv/
env/
.conda/

# IDE / OS temp
.vscode/
.idea/
*.swp
*~
.DS_Store

# Secrets (must never be committed)
.env
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*

# Large raw / derived data (keep directory placeholders)
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*/*
!data/processed/*/.gitkeep
cache/*/*
!cache/*/.gitkeep

# Large binary model weights / checkpoints anywhere (hash them in registries/run metadata)
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Third-party files fetched for audits (hashes tracked in official_repo_manifest.json)
outputs/audit/siw_subject_recovery/official_repo_cache/

# M2A diagnostic smoke outputs (DIAGNOSTIC_ONLY; images/tensors never committed)
outputs/exploratory/m2a_smoke/

# Pinned third-party source checkouts fetched for adaptation audits (pins + blob hashes are
# tracked in third_party/registry.yaml and third_party/source_pins.json; sources are never committed)
third_party/source_cache/
